pico-8 cartridge // http://www.pico-8.com
version 39
__lua__
function _init()
	--run to start/reset the game
	start_screen = true
	game_screen = false
end

function _draw()
	cls()
	rect(0,0,127,127,7)
	if start_screen then
		draw_start_screen()
	end
	
	if game_screen then
		draw_game_screen() 
	end
end

function _update()
	if btnp(❎) and start_screen then
		start_screen = false
		game_screen = true
	end
	
	move_player()
	
end
-->8
--draw

function draw_start_screen()
 print("press start to play", 32, 60, 7)
end

function draw_game_screen()
	spr(player.sprite, player.x, player.y)
end

-->8
--update

function move_player()
	
	vx = player.velocity_x
	vy = player.velocity_y
	
	if (btn(⬅️)) then 
		player.x -= vx
	end
	
	if (btn(⬆️)) then
			player.y -= vy
 
	end
	
	if (btn(➡️)) then 
			player.x += vx

	end
	
	if (btn(⬇️)) then
			player.y += vy
 
	end
end	


-->8
-- global variables
start_screen = true
game_screen = false

player = 
{
x=50, 
y= 50, 
velocity_x= 2,
velocity_y=2, 
sprite=1
}

