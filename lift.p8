-- sounds and music

patterns= {
	main_theme = 0
}

sounds = {
	start = 0,
	game_over = 2
}

function play_music(pattern)
	-- -1 means no music
	
	music(pattern)
end

function play_sound(sound)
	sfx(sound)
end
