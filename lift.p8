--pause menu
function pause_init()
	_update=pause_update
	_draw=pause_draw
	scene="pause"
	play_music(1)
end

function pause_update()
	if (btnp(🅾️)) game_init()
end

function pause_draw()
	cls()
	print("pause!",px,py)
end
-->8
--game over screen

function gameover_init()
		play_sound(2)
	_update=gameover_update
	_draw=gameover_draw
	scene="gameover"
	play_music(-1)
end

function gameover_update()
	if (btnp(❎)) menu_init()
end

function gameover_draw()
	cls()
	print("gameover!",px,py)
	
end
