-- sounds and music

patterns= {
	main_theme = 0
}

sounds = {
	start = 0,
	game_over = 2,
	friction_time = 6,
	jump = 7
}

function play_music(pattern)
	-- -1 means no music
	music(pattern)
end

function play_sound(sound)
	sfx(sound)
end
