--main menu
px,py=20,54
function _init() menu_init() end

function menu_init()
 _update=menu_update
 _draw=menu_draw
 scene="menu"
 make_player()
end

function menu_update()
 if (btnp(❎)) game_init() --play the game
end

function menu_draw()
	cls()
	--print("menu!",30,30) --menu draw code
	print("press ❎ to start",35,64)
end

-->8
--game loop

changing_room = false

panims={
	idlev={fr=15,18,19},
	walkv={fr=5,4,5,6},
	jumpv={},
	crouchv={fr=1,23},
	idle={fr=15,16,17},
	walk={fr=5,1,2,3},
	jump={fr=5,2},
	crouch={fr=1,21}
}

vanims={
	v_idle={fr=15,18,19},
	walk={fr=5,1,2,3},
	jump={fr=5,2}
}

eanims={
	idle={fr=15,128,130},
	walk={fr=10,138,140},
	atk={fr=5,132,134}
}

enemies = {}

gravity=0.3
friction=0.85

function game_init()
	
	c_change_room = cocreate(change_room)

	play_sound(sounds.start) -- start up sound
	_update=game_update
	_draw=game_draw
	scene="game" 
	play_music(0)
	
	-- camera offsets
	cx, cy = 0, 0
	mx, my = 0, 0
	
	box = {}
	box.x = 25
	box.y = 40
	box.w = 70
	box.h = 32
	
	
	--test enemy
	add(enemies,make_enemy(px+40,py))
end

function game_update()

	if c_change_room and costatus(c_change_room)!="dead" then
		if collide_map(p, "right", 7) or collide_map(p, "left", 7) then
			coresume(c_change_room)
		end
		if costatus(c_change_room)=="dead" then
			c_change_room = cocreate(change_room)
		end
	end
	
	--if (btnp(🅾️)) gameover_init() --game over
	update_player()
	for e in all(enemies) do
		update_enemy(e)
	end
	--if (v.active) update_vine()
end

function game_draw()
	cls()
	
	print("level 1",50,20, 14)
	print("level 2",150,20, 13)
	print("level 3",500,70, 12)
	
	camera(cx,cy)
	map(0, 0)
	draw_player()

	for e in all(enemies) do
		draw_enemy(e)
	end

	if (not p.vine) draw_vine()
	
	if v then
		if v.dropped then 
			draw_new_tiles()
		end
	end

	rect(box.x, box.y,
						box.x+box.w, box.y+box.h, 11)
end

--player functions
function make_player()
	p = {}
	p.x=px
	p.y=py+10
	p.dx=0
	p.dy=0
	p.max_dx=2
	p.max_dy=3
	p.acc=0.5
	p.boost=4
	p.spr=1
	p.play="idlev"
	p.sw=1
	p.sh=1
	p.flp=false
	p.vine=true
	p.anims=panims
	p.dir = "" 
	
	p.friction_time = false
	p.timer = time()
	
	p.jump = false
	p.jump_velocity = 4
	
end

function update_player()
	if (not changing_room) then
		move_player()
		animate(p)
	end
end

function draw_player()
	print("x: " .. flr(p.x) .. " y: " .. 
	flr(p.y), p.x-15, p.y -10)
	

	spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.flp!=(p.spr<0))
	if p.friction_time then
		print("friction time!", p.x-20, p.y-20, 10)
	end
end

function move_player()
	
	
	-- camera
	--change_room_camera()
	scroll_camera()

	
	--add gravity
	p.dy+=gravity
	p.dx*=friction
	
	if btn(0) and not p.friction_time then
	 p.dx-=p.acc
	 p.flp=true
	 p.play="walk"

	elseif btn(1) and not p.friction_time then
	 p.dx+=p.acc
	 p.flp=false
	 p.play="walk"
	 
	 
	elseif btn(3) then
		p.play="crouch"
		

		if btnp(5) and p.vine then
		 p.vine=false
		 make_vine(p)
		 v.timer = time()
		 
		 if collide_map(v, "down", 2) then
		 	v.dropped = true
			end
		elseif btnp(5) and (not p.vine) and collide_sprite(p,"center",v) and (time() - v.timer) > 0.5 then
		 p.vine=true
		 v.active=false
		 v.dropped = false
		end
	else
		p.play="idle"
	end


	if p.friction_time then 
	--[[ friction time lasts for
		1/2 a second, or 15 frames
	--]]
		
		if abs(p.timer - time()) < 0.5 then
			if p.flp then
				p.dx -= 1
			else
				p.dx += 1
			end
		else
			p.friction_time = false
		end
	end
	 
	--if btn(❎) and not p.friction_time and not btn(3) then
	--	p.friction_time = true
	--	p.timer = time()
	--	play_sound(sounds.friction_time)
	--end
	
	
	--handle vine
	if (p.vine and p.play[-1]!="v") then
	 p.play=p.play.."v"
	end
	--if btn(2) then p.y-=1 end
	--if btn(3) then p.y-=1 end
	
	--jumping
	jump()
	
	
	--check collision up and down
	if p.dy>0 and collide_map(p,"down",0) then
		p.dy=0
		p.y-=((p.y+p.sh*8+1)%8)-1
		
		--[[
		these two variables
		are set to false when player
		hits the ground
		--]]
		p.fall = false
		p.jump = false
		
	elseif p.dy<0 and collide_map(p,"up",1) then
		p.dy=0
	end
	
	--check collision left and right
	if p.dx<0 and collide_map(p,"left",1) then
		p.dx=0
	elseif p.dx>0 and collide_map(p,"right",1) then
		p.dx=0
	end
	
	--add diffs
	p.x+=p.dx
	p.y+=p.dy
end


function jump()
		-- 4 == z
	if (btnp(4)) and not p.jump then
		p.jump = true
		play_sound(sounds.jump)
	end
	
	if p.jump and p.jump_velocity > 1 and not p.fall then
		p.dy -= p.jump_velocity
		p.jump_velocity -= 0.8
	end
	
	-- start falling 
	if p.jump and p.jump_velocity <= 1 then
		p.fall = true
	end
	
	if not p.jump then
		p.jump_velocity = 2
	end
end

--vine functions
function make_vine(p)
	v = {}
	v.x=p.x
	v.y=p.y
	v.spr=48
	v.play="v_idle"
	v.sw=1
	v.sh=1
	v.flp=false
	v.active=true
	v.dropped = false
end

function update_vine()

--delete vine if not active
	if (not v.active) del(v)

end

function draw_vine()
		spr(abs(v.spr),v.x,v.y,v.sw,v.sh,v.flp!=(v.spr<0))
end

function draw_new_tiles()
	for i=0,40,5 do
		
		spr(75, v.x+i, v.y+8)
	end
end


--enemy functions
function make_enemy(x,y)
	e = {}
	e.x=x
	e.y=y
	e.dx=0
	e.dy=0
	e.max_dx=2
	e.max_dy=3
	e.acc=0.1
	e.spr=128
	e.play="idle"
	e.sw=2
	e.sh=2
	e.flp=false
	e.anims=eanims
	
	p.timer = time()
	
	--p.jump = false
	--p.jump_velocity = 4
	
	return e
end

function update_enemy(e)
	dir = pdir(e.x)
	
	e.dy += gravity
	e.dx *= friction
	if dir > 0 then
		e.flp = true
	else
		e.flp = false
	end
	if pdist(e.x,e.y) < 16 then
		e.play = "atk"
	elseif pdist(e.x,e.y) < 50 then
		e.play = "walk"
		if dir > 0 then
			e.dx -= e.acc
		else
			e.dx += e.acc
		end
	else
		e.play="idle"
	end
	e.x += e.dx
	e.y += e.dy
	
	--map collision
	if e.dy>0 and collide_map(e,"down",0) then
		e.dy=0
		e.y-=((e.y+e.sh*8+1)%8)-1
	elseif e.dy<0 and collide_map(e,"up",1) then
		p.dy=0
	end
	
	--check collision left and right
	if e.dx<0 and collide_map(e,"left",1) then
		e.dx=0
	elseif e.dx>0 and collide_map(e,"right",1) then
		e.dx=0
	end

	
	animate(e)
		
end

function draw_enemy(e)
	spr(abs(e.spr),e.x,e.y,e.sw,e.sh,e.flp!=(e.spr<0))
end

--animation
function animate(p)
	if p.state != p.play then
		p.state = p.play
		p.animindex=1
		p.time=0
	elseif #p.anims[p.state] > 1 then
		p.time+=1
		if p.time > p.anims[p.state].fr then
			p.time=0
			p.animindex = (p.animindex % #p.anims[p.state]) + 1
			if p.animindex==1 and p.anims[p.state].next then
				p.play=p.anims[p.state].next
				p.state=p.play
			end
		end
	end
	p.spr = p.anims[p.state][p.animindex]
end


