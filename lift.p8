-- sounds and music

patterns= {
	main_theme = 0
}

sounds = {
	start = 0,
	game_over = 2,
	friction_time = 6,
	jump = 7
}

function play_music(pattern)
	-- -1 means no music
	music(pattern)
end

function play_sound(sound)
	sfx(sound)
end
-->8
--camera
function change_room_camera()
	
	if px > 127 then cx = 128
	else cx = 0
	end
	
end

function scroll_camera()
	
	--basic scrolling
	--cx = px - 64
	--cy = py - 64
	
	--[[slighty less basic 
	scrolling	
	--]]

	if p.x <= box.x then
		cx -= box.x - p.x
		box.x=p.x
		
	elseif p.x+p.sw*8 >= box.x+box.w then
		local diff = (p.x+p.sw*8) - (box.x + box.w)
		cx += diff
		box.x += diff
	end
	
	
	if p.y < box.y then
		cy -= box.y - p.y
		box.y -= box.y - p.y
	end
	
	if p.y+p.sh*8 > box.y + box.h then
		local diffy = (p.y+p.sh*8) - (box.y+box.h)
		cy += diffy
		box.y += diffy
	end
end

function change_room()
	changing_room = true
	
	local current_gravity = gravity

	if not p.flp then
		scroll_speed = 5
		player_push = 20
	else
		scroll_speed = -scroll_speed
		player_push = -player_push
	end
	
	
	for i=0, 20 do -- for 30 frames 
		
		cx += scroll_speed
		box.x += scroll_speed
		gravity = 0
		yield()
	end
	p.x += player_push

	p.dx=0
	p.dy=0
	changing_room = false
	gravity = current_gravity
		
end

