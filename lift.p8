--main menu
px,py=10,50
function _init() menu_init() end

function menu_init()
 _update=menu_update
 _draw=menu_draw
 scene="menu"
 make_player()
end

function menu_update()
 if (btnp(❎)) game_init() --play the game
end

function menu_draw()
	cls()
	print("menu!",px,py) --menu draw code
	print("press❎ to start",px,py+6)
end
-->8
--game loop
panims={
	idlev={fr=15,18,19},
	walkv={fr=5,4,5,6},
	jumpv={},
	crouchv={fr=1,23},
	idle={fr=15,16,17},
	walk={fr=5,1,2,3},
	jump={fr=5,2},
	crouch={fr=1,21}
}

vanims={
	v_idle={fr=15,18,19},
	walk={fr=5,1,2,3},
	jump={fr=5,2}
}


function game_init()
	play_sound(sounds.start) -- start up sound
	_update=game_update
	_draw=game_draw
	scene="game" 
	play_music(0)
end

function game_update()
	
	if (btnp(❎)) pause_init() --pause
	if (btnp(🅾️)) gameover_init() --game over
	update_player()
	--if (v.active) update_vine()
end

function game_draw()
	cls()
	print("game!",px,py) --game draw code
	draw_player()
end

--player functions
function make_player()
	p = {}
	p.x=px
	p.y=py+10
	p.spr=1
	p.play="idlev"
	p.sw=1
	p.sh=1
	p.left=false
	p.vine=true
	p.anims=panims
end

function update_player()
	move_player()
	animate(p)
end

function draw_player()
	spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.left!=(p.spr<0))
end

function move_player()
	
	if btn(0) then
	 p.x-=1
	 p.left=true
	 p.play="walk"
	elseif btn(1) then
	 p.x+=1
	 p.left=false
	 p.play="walk"
	elseif btn(3) then
		p.play="crouch"
		if btn(5) then
		 p.vine=false
		 make_vine(p)
		end
	else
		p.play="idle"
	end
	
	
	--handle vine
	if (p.vine and p.play[-1]!="v") then
	 p.play=p.play.."v"
	 print(p.play)
	end
	--if btn(2) then p.y-=1 end
	--if btn(3) then p.y-=1 end
end

--vine functions
function make_vine(p)
	v = {}
	v.x=p.x
	v.y=p.y
	v.spr=32
	v.play="v_idle"
	v.sw=1
	v.sh=1
	v.active=false
end

function update_vine()

--delete vine if not active
	del(v)
end

function draw_vine()
end


--enemy functions
function make_enemy(x,y)
end

function update_enemy(e)
end

function draw_enemy(e)
end

--animation
function animate(p)
	if p.state != p.play then
		p.state = p.play
		p.animindex=1
		p.time=0
	elseif #p.anims[p.state] > 1 then
		p.time+=1
		if p.time > p.anims[p.state].fr then
			p.time=0
			p.animindex = (p.animindex % #p.anims[p.state]) + 1
			if p.animindex==1 and p.anims[p.state].next then
				p.play=p.anims[p.state].next
				p.state=p.play
			end
		end
	end
	p.spr = p.anims[p.state][p.animindex]
end



