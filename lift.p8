--game loop


panims={
	idlev={fr=15,18,19},
	walkv={fr=5,4,5,6},
	jumpv={},
	crouchv={fr=1,23},
	idle={fr=15,16,17},
	walk={fr=5,1,2,3},
	jump={fr=5,2},
	crouch={fr=1,21}
}

vanims={
	v_idle={fr=15,18,19},
	walk={fr=5,1,2,3},
	jump={fr=5,2}
}

gravity=0.3
friction=0.85

function game_init()
	play_sound(sounds.start) -- start up sound
	_update=game_update
	_draw=game_draw
	scene="game" 
	play_music(0)
end

function game_update()
	--if (btnp(🅾️)) gameover_init() --game over
	update_player()
	--if (v.active) update_vine()
end

function game_draw()
	cls()
	map(0, 0, 0, 0)
	print("level 1",50,20, 15) --game draw code
	draw_player()
	if (not p.vine) draw_vine() 
end

--player functions
function make_player()
	p = {}
	p.x=px
	p.y=py+10
	p.dx=0
	p.dy=0
	p.max_dx=2
	p.max_dy=3
	p.acc=0.5
	p.boost=4
	p.spr=1
	p.play="idlev"
	p.sw=1
	p.sh=1
	p.flp=false
	p.vine=true
	p.anims=panims
	
	p.friction_time = false
	p.timer = time()
	
	p.jump = false
	p.jump_velocity = 4
	
end

function update_player()
	move_player()
	animate(p)
end

function draw_player()
	spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.flp!=(p.spr<0))
	if p.friction_time then
		print("friction time!", p.x-20, p.y-20, 10)
	end
end

function move_player()
	
	--add gravity
	p.dy+=gravity
	p.dx*=friction
	
	if btn(0) and not p.friction_time then
	 p.dx-=p.acc
	 p.flp=true
	 p.play="walk"
	elseif btn(1) and not p.friction_time then
	 p.dx+=p.acc
	 p.flp=false
	 p.play="walk"
	elseif btn(3) then
		p.play="crouch"
		if btnp(5) and p.vine then
		 p.vine=false
		 make_vine(p)
		 v.timer = time()
		elseif btnp(5) and (not p.vine) and collide_sprite(p,"center",v) and (time() - v.timer) > 0.5 then
		 p.vine=true
		 v.active=false
		end
	else
		p.play="idle"
	end


	if p.friction_time then 
	--[[ friction time lasts for
		1/2 a second, or 15 frames
	--]]
		
		if abs(p.timer - time()) < 0.5 then
			if p.flp then
				p.x -= 2
			else
				p.x += 2
			end
		else
			p.friction_time = false
		end
	end
	 
	if btn(❎) and not p.friction_time and not btn(3) then
		p.friction_time = true
		p.timer = time()
		play_sound(sounds.friction_time)
	end
	
	
	--handle vine
	if (p.vine and p.play[-1]!="v") then
	 p.play=p.play.."v"
	end
	--if btn(2) then p.y-=1 end
	--if btn(3) then p.y-=1 end
	
	--jumping
	jump()
	
	
	--check collision up and down
	if p.dy>0 and collide_map(p,"down",0) then
		p.dy=0
		p.y-=((p.y+p.sh*8+1)%8)-1
		
		--[[
		these two variables
		are set to false when player
		hits the ground
		--]]
		p.fall = false
		p.jump = false
		
	elseif p.dy<0 and collide_map(p,"up",1) then
		p.dy=0
	end
	
	--check collision left and right
	if p.dx<0 and collide_map(p,"left",1) then
		p.dx=0
	elseif p.dx>0 and collide_map(p,"right",1) then
		p.dx=0
	end
	
	--add diffs
	p.x+=p.dx
	p.y+=p.dy
end


function jump()
		-- 4 == z
	if (btnp(4)) and not p.jump then
		p.jump = true
		play_sound(sounds.jump)
	end
	
	if p.jump and p.jump_velocity > 1 and not p.fall then
		p.dy -= p.jump_velocity
		p.jump_velocity -= 0.8
	end
	
	-- start falling 
	if p.jump and p.jump_velocity <= 1 then
		p.fall = true
	end
	
	if not p.jump then
		p.jump_velocity = 2
	end
end

--vine functions
function make_vine(p)
	v = {}
	v.x=p.x
	v.y=p.y
	v.spr=48
	v.play="v_idle"
	v.sw=1
	v.sh=1
	v.flp=false
	v.active=true
end

function update_vine()

--delete vine if not active
	if (not v.active) del(v)

end

function draw_vine()
		spr(abs(v.spr),v.x,v.y,v.sw,v.sh,v.flp!=(v.spr<0))
end


--enemy functions
function make_enemy(x,y)
end

function update_enemy(e)
end

function draw_enemy(e)
end

--animation
function animate(p)
	if p.state != p.play then
		p.state = p.play
		p.animindex=1
		p.time=0
	elseif #p.anims[p.state] > 1 then
		p.time+=1
		if p.time > p.anims[p.state].fr then
			p.time=0
			p.animindex = (p.animindex % #p.anims[p.state]) + 1
			if p.animindex==1 and p.anims[p.state].next then
				p.play=p.anims[p.state].next
				p.state=p.play
			end
		end
	end
	p.spr = p.anims[p.state][p.animindex]
end


