-- planets
planets = {
	p1={spr=64,x=200,y=70,sz=2,c=5},
	p2={spr=66,x=-100,y=30,sz=2,c=11},
	p3={spr=68,x=200,y=100,sz=2,c=12},
	p4={spr=70,x=-200,y=-50,sz=2,c=6}
}


function draw_planets()
	for _,pl in pairs(planets) do
		spr(pl.spr,pl.x,pl.y,pl.sz,pl.sz)
	end
end

function draw_pind()
	--planet indicators
	local indd=16
	for _,pl in pairs(planets) do
		local pdx=p.x-pl.x
		local pdy=p.y-pl.y
		if abs(pdx) > 64 or abs(pdy) > 64 then
			local dir=atan2(pdx,pdy)
			local dirx=-indd*cos(dir)
			local diry=-indd*sin(dir)
			circfill(p.x+p.sw*8/2+dirx,p.y+p.sh*8/2+diry,2,pl.c)
		end
	end
end

function draw_stars()
	--screen=128x128
	local csx=flr(p.x/128)
	local csy=flr(p.y/128)
	
	for i=-1,1 do
		for j=-1,1 do
			--populate each area
			srand((i+csx)+(j+csy)*100)
			local x0=(i+csx)*128
			local y0=(j+csy)*128
			for k=1,50 do
				generate_star(x0,y0)
			end
		end
	end

end

function generate_star(x0,y0)
	local x=rnd(128)+x0
	local y=rnd(128)+y0
	local c=rnd(8)
	
	if (c>4) return
	c+=5
	if (c==8) c-=1
	pset(x,y,c)
end
-->8
--astronaut
function make_astronaut()
	a = {}
	a.x = 70
	a.y = 70
	a.spr = 32
	a.size = 2
	a.anim_time = 0
	a.anim_descend = true
	
end
function draw_astronaut()
	spr(a.spr, a.x, a.y, a.size, a.size)
end

function update_astronaut()
	
	if time() - a.anim_time > .08 then
		if a.anim_descend then
			a.spr += 2
			a.anim_time = time()
			if a.spr == 42 then
				a.spr = 32
			end
		end
		
		--[[if not a.anim_descend then
			a.spr -= 2
			a.anim_time = time()
		end
		
		if a.spr == 44 then
			a.anim_descend = false
		end
		if a.spr == 32 then
			a.anim_descend = true
		end--]]
	end
	
	
end
