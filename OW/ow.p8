pico-8 cartridge // http://www.pico-8.com
version 40
__lua__
--init
--new game in space!!!
--by gdb


function _init() menu_init() end

function menu_init()
 _update=menu_update
 _draw=menu_draw
 scene="menu"
 make_player()
end

function menu_update()
 if (btnp(❎)) game_init() --play the game
end

function game_init()
	game_over = false
	_update=game_update
	_draw=game_draw
	scene="game" 
	
	-- camera offsets
	cx, cy = 0, 0
	mx, my = 0, 0
end
-->8
--draw 

function menu_draw()
	cls()
	print("press ❎ to start",35,64, 9)
end


function game_draw()
	cls()
	camera(cx,cy)
	map(0, 0)
	draw_player()
end
-->8
--update


function game_update()
end
-->8
--player

panims={
	idle={fr=15,18,19},
	thrust={fr=15,4,5}
}

function make_player()
	p = {}
	p.spr = 2
	p.x=50
	p.y=50
	p.dx=0
	p.dy=0
	p.max_dx=2
	p.max_dy=3
	p.acc=0.5
	p.boost=4
	p.play="idle"
	p.sw=2
	p.sh=2
	p.flp=false
	p.anims=panims
end

function draw_player()
	spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.flp!=(p.spr<0))
end
