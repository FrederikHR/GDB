__lua__
--init
--new game in space!!!
--by gdb


function _init() menu_init() end

function menu_init()
 _update=menu_update
 _draw=menu_draw
 scene="menu"
 make_player()
end

function menu_update()
 if (btnp(❎)) game_init() --play the game
end

function game_init()
	game_over = false
	_update=game_update
	_draw=game_draw
	scene="game" 
	
	-- camera offsets
	cx, cy = 0, 0
	mx, my = 0, 0
	
	
	box = {}
	box.x = 25
	box.y = 40
	box.w = 70
	box.h = 32
end
-->8
--draw and camera

function menu_draw()
	cls()
	print("press ❎ to start",35,64, 9)
end


function game_draw()
	cls()
	camera(cx,cy)
	map(0, 0)
	if p.space then
		draw_stars()
		draw_planets()
		draw_player()
		draw_pind()
	else
		--do on-planet stuff
		print("aaaa")
	end
end

function spr_r(s,x,y,a,w,h)
 sw=(w or 1)*8
 sh=(h or 1)*8
 sx=(s%16)*8
 sy=flr(s/16)*8
 x0=flr(0.5*sw)
 y0=flr(0.5*sh)
 a=a/360
 sa=sin(a)
 ca=cos(a)
 for ix=0,sw-1 do
  for iy=0,sh-1 do
   dx=ix-x0
   dy=iy-y0
   xx=flr(dx*ca-dy*sa+x0)
   yy=flr(dx*sa+dy*ca+y0)
   if (xx>=0 and xx<sw and yy>=0 and yy<=sh) then
    pset(x+ix,y+iy,sget(sx+xx,sy+yy))
   end
  end
 end
end

function scroll_camera(s)

	--basic scrolling
	--cx = px - 64
	--cy = py - 64

	--[[slighty less basic 
	scrolling	
	--]]
	if s then
		cx=p.x-50+p.sw/2
		cy=p.y-50+p.sh/2
	else
		if p.x <= box.x then
			cx -= box.x - p.x
			box.x=p.x

		elseif p.x+p.sw*8 >= box.x+box.w then
			local diff = (p.x+p.sw*8) - (box.x + box.w)
			cx += diff
			box.x += diff
		end


		if p.y < box.y then
			cy -= box.y - p.y
			box.y -= box.y - p.y
		end

		if p.y+p.sh*8 > box.y + box.h then
			local diffy = (p.y+p.sh*8) - (box.y+box.h)
			cy += diffy
			box.y += diffy
		end
	end
end

function animate(p)
	if p.state != p.play then
		p.state = p.play
		p.animindex=1
		p.time=0
	elseif #p.anims[p.state] > 1 then
		p.time+=1
		if p.time > p.anims[p.state].fr then
			p.time=0
			p.animindex = (p.animindex % #p.anims[p.state]) + 1
			if p.animindex==1 and p.anims[p.state].next then
				p.play=p.anims[p.state].next
				p.state=p.play
			end
		end
	end
	p.spr = p.anims[p.state][p.animindex]
end

-->8
--update


function game_update()
	if p.space then
		update_player()
		scroll_camera()
		--land()
	else
		update_player()
		scroll_camera(true)
	end
end
-->8
--player

panims={
	idle={fr=15,38,38},
	thrust={fr=15,38,38}
}

friction=1

function make_player()
	p = {}
	p.spr=2
	p.x=50
	p.y=50
	p.a=0
	p.dx=0
	p.dy=0
	p.max_dx=2
	p.max_dy=3
	p.acc=1
	p.boost=4
	p.play="idle"
	p.sw=2
	p.sh=2
	p.flp=false
	p.space=true
	p.anims=panims
end

function draw_player()
	--spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.flp!=(p.spr<0))
	spr_r(p.spr,p.x,p.y,p.a,p.sw,p.sh)
end

function update_player()
	if p.space then
		move_player()
	else
	move_player()
	--animate(p)
	end
end

function move_player()
	--add gravity
	if p.space then
		local gx=0.
		local gy=0.
		gx,gy=gravity()
		p.dx+=gx
 	p.dy+=gy
 else
 	p.dy+=0.5
	--p.dx*=friction
	--p.dy*=friction
	end
	
	if p.space then
		if btn(⬅️) then
	 	p.a-=10
		elseif btn(➡️) then
			p.a+=10
		end 
		if btn(⬆️) then
			p.play="thrust"
			at = -(p.a-90)/360
			p.dx+=p.acc*cos(at)
			p.dy+=p.acc*sin(at)
		else
			p.play="idle"
		end
	else
		if btn(⬅️) then
	 	p.a-=10
		elseif btn(➡️) then
			p.a+=10
		end 
		if btn(⬆️) then
			p.play="thrust"
			at = -(p.a-90)/360
			p.dx+=p.acc*cos(at)
			p.dy+=p.acc*sin(at)
		else
			p.play="idle"
		end
	end
	
	--jumping
	if (not p.space) then
	 jump()
	
		--check collision up and down
		if p.dy>0 and collide_map(p,"down",0) then
			p.dy=0
			p.y-=((p.y+p.sh*8+1)%8)-1
		
			--[[
			these two variables
			are set to false when player
			hits the ground
			--]]
		p.fall = false
		p.jump = false
		
		elseif p.dy<0 and collide_map(p,"up",1) then
			p.dy=0
		end
	
		--check collision left and right
		if p.dx<0 and collide_map(p,"left",1) then
			p.dx=0
		elseif p.dx>0 and collide_map(p,"right",1) then
			p.dx=0
		end
	end
	
	--limit speeds
	if (p.dx>5) p.dx=5
	if (p.dy>5) p.dy=5
	
	--add diffs
	p.x+=p.dx
	p.y+=p.dy
end

function land()
	--if pcoll() then
	--end
	print("aaaaa")
end

-->8
--other functions

function gravity()
 --calculate simple gravity on ship
 gravc=0.005
	local pd=-1
	local pdx=0
	local pdy=0
	local magx=0
	local magy=0
	--find closest planet
	for _,pl in pairs(planets) do
		if (pd==-1) then
		 pd=pdist(pl.x,pl.y)
		 pdx=pl.x
		 pdy=pl.y
		end
		if (pdist(pl.x,pl.y)<pd) then
			pd=pdist(pl.x,pl.y)
			pdx=pl.x
			pdy=pl.y
		end
	end
	
	local p2=pd--^2
	if (p2<0) return 32767.9999
	local mag=gravc/(p2)
	magx+=mag*(pdx-p.x)
	magy+=mag*(pdy-p.y)

	if (magx>10) magx=10
	if (magy>10) magy=10
	if (magx<-10) magx=-10
	if (magy<-10) magy=-10

	if pd>1 then
			magx=0
			magy=0
	end

	return magx,magy
end


function collide_map(obj,aim,flag)
	--obj = table, needs x,y,w,h
	local x=obj.x    local y=obj.y
	local w=obj.sw*8 local h=obj.sh*8
	
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1    y1=y
		x2=x      y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1    y1=y
		x2=x+w      y2=y+h-1
	elseif aim=="up" then
		x1=x+2    y1=y-1
		x2=x+w-3  y2=y
	elseif aim=="down" then
		x1=x+2      y1=y+h
		x2=x+w-2    y2=y+h
 elseif aim=="center" then
		x1=x-2      y1=y-2
		x2=x+w+2    y2=y+h+2
	end
	
	--pixels to tiles
	x1/=8 y1/=8
	x2/=8 y2/=8
	
	if fget(mget(x1,y1),flag)
	or fget(mget(x1,y2),flag)
	or fget(mget(x2,y1),flag)
	or fget(mget(x2,y2),flag) then
		return true
	end
	return false
end

function collide_sprite(obj,aim,obj2)
	--obj = table, needs x,y,w,h
	local x=obj.x    local y=obj.y
	local w=obj.sz*8 local h=obj.sz*8
	
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1    y1=y
		x2=x      y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1    y1=y
		x2=x+w      y2=y+h-1
	elseif aim=="up" then
		x1=x+2    y1=y-1
		x2=x+w-3  y2=y
	elseif aim=="down" then
		x1=x+2      y1=y+h
		x2=x+w-2    y2=y+h
 elseif aim=="center" then
		x1=x-2      y1=y-2
		x2=x+w+2    y2=y+h+2
	end
	
	--pixels to tiles
	--x1/=8 y1/=8
	--x2/=8 y2/=8
	if not(obj2.x > (x1+(x2-x1)))
	or not(obj2.y > (y1+(y2-y1)))
	or not((obj2.x+obj2.sz*8) < x1)
	or not((obj2.y+obj2.sz*8) < y1) then
		return true
	end
	
	return false
end

function pdist(x,y)
	local dx=(x-p.x)/64
	local dy=(y-p.y)/64
	
	local dsq=dx*dx+dy*dy
	
	if (dsq<0) return 32767.9999
	
	return sqrt(dsq)
end

function pcoll(x,y)
	if pdist(x,y) < 5 then
		print("aaaa",p.x,p.y,7)
	end
end
-->8
-- planets
planets = {
	p1={spr=64,x=200,y=70,sz=2,c=5},
	p2={spr=66,x=-100,y=30,sz=2,c=11},
	p3={spr=68,x=200,y=100,sz=2,c=12},
	p4={spr=70,x=-200,y=-50,sz=2,c=6}
}


function draw_planets()
	for _,pl in pairs(planets) do
		spr(pl.spr,pl.x,pl.y,pl.sz,pl.sz)
	end
end

function draw_pind()
	--planet indicators
	local indd=16
	for _,pl in pairs(planets) do
		local pdx=p.x-pl.x
		local pdy=p.y-pl.y
		if abs(pdx) > 64 or abs(pdy) > 64 then
			local dir=atan2(pdx,pdy)
			local dirx=-indd*cos(dir)
			local diry=-indd*sin(dir)
			circfill(p.x+p.sw*8/2+dirx,p.y+p.sh*8/2+diry,2,pl.c)
		end
	end
end

function draw_stars()
	--screen=128x128
	local csx=flr(p.x/128)
	local csy=flr(p.y/128)
	
	for i=-1,1 do
		for j=-1,1 do
			--populate each area
			srand((i+csx)+(j+csy)*100)
			local x0=(i+csx)*128
			local y0=(j+csy)*128
			for k=1,50 do
				generate_star(x0,y0)
			end
		end
	end

end

function generate_star(x0,y0)
	local x=rnd(128)+x0
	local y=rnd(128)+y0
	local c=rnd(8)
	
	if (c>4) return
	c+=5
	if (c==8) c-=1
	pset(x,y,c)
end
