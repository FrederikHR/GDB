--player

panims={
	idle={fr=15,38,38},
	thrust={fr=15,38,38}
}

friction=1

function make_player()
	p = {}
	p.spr=2
	p.x=50
	p.y=50
	p.a=0
	p.dx=0
	p.dy=0
	p.max_dx=2
	p.max_dy=3
	p.acc=1
	p.boost=4
	p.play="idle"
	p.sw=2
	p.sh=2
	p.flp=false
	p.space=true
	p.anims=panims
end

function draw_player()
	--spr(abs(p.spr),p.x,p.y,p.sw,p.sh,p.flp!=(p.spr<0))
	spr_r(p.spr,p.x,p.y,p.a,p.sw,p.sh)
end

function update_player()
	if p.space then
		move_player()
	else
	move_player()
	--animate(p)
	end
end

function move_player()
	--add gravity
	if p.space then
		local gx=0.
		local gy=0.
		gx,gy=gravity()
		p.dx+=gx
 	p.dy+=gy
 else
 	p.dy+=0.5
	--p.dx*=friction
	--p.dy*=friction
	end
	
	if p.space then
		if btn(⬅️) then
	 	p.a-=10
		elseif btn(➡️) then
			p.a+=10
		end 
		if btn(⬆️) then
			p.play="thrust"
			at = -(p.a-90)/360
			p.dx+=p.acc*cos(at)
			p.dy+=p.acc*sin(at)
		else
			p.play="idle"
		end
	else
		if btn(⬅️) then
	 	p.a-=10
		elseif btn(➡️) then
			p.a+=10
		end 
		if btn(⬆️) then
			p.play="thrust"
			at = -(p.a-90)/360
			p.dx+=p.acc*cos(at)
			p.dy+=p.acc*sin(at)
		else
			p.play="idle"
		end
	end
	
	--jumping
	if (not p.space) then
	 jump()
	
		--check collision up and down
		if p.dy>0 and collide_map(p,"down",0) then
			p.dy=0
			p.y-=((p.y+p.sh*8+1)%8)-1
		
			--[[
			these two variables
			are set to false when player
			hits the ground
			--]]
		p.fall = false
		p.jump = false
		
		elseif p.dy<0 and collide_map(p,"up",1) then
			p.dy=0
		end
	
		--check collision left and right
		if p.dx<0 and collide_map(p,"left",1) then
			p.dx=0
		elseif p.dx>0 and collide_map(p,"right",1) then
			p.dx=0
		end
	end
	
	--limit speeds
	if (p.dx>5) p.dx=5
	if (p.dy>5) p.dy=5
	
	--add diffs
	p.x+=p.dx
	p.y+=p.dy
end

function land()
	--if pcoll() then
	--end
	print("aaaaa")
end

