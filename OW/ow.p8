--init
--new game in space!!!
--by gdb


function _init() menu_init() end

function menu_init()
 _update=menu_update
 _draw=menu_draw
 scene="menu"
 make_player()
 make_astronaut()
end

function menu_update()
 if (btnp(❎)) game_init() --play the game
end

function game_init()
	
	game_over = false
	_update=game_update
	_draw=game_draw
	scene="game" 
	
	-- camera offsets
	cx, cy = 0, 0
	mx, my = 0, 0
	
	
	box = {}
	box.x = 25
	box.y = 40
	box.w = 70
	box.h = 32
end
-->8
--draw and camera

function menu_draw()
	cls()
	print("press ❎ to start",35,64, 9)
end


function game_draw()
	cls()
	camera(cx,cy)
	map(0, 0)
	if p.space then
		draw_stars()
		draw_planets()
		draw_player()
		draw_pind()
		draw_astronaut()
	else
		--do on-planet stuff
		print("aaaa")
	end
end

function spr_r(s,x,y,a,w,h)
 sw=(w or 1)*8
 sh=(h or 1)*8
 sx=(s%16)*8
 sy=flr(s/16)*8
 x0=flr(0.5*sw)
 y0=flr(0.5*sh)
 a=a/360
 sa=sin(a)
 ca=cos(a)
 for ix=0,sw-1 do
  for iy=0,sh-1 do
   dx=ix-x0
   dy=iy-y0
   xx=flr(dx*ca-dy*sa+x0)
   yy=flr(dx*sa+dy*ca+y0)
   if (xx>=0 and xx<sw and yy>=0 and yy<=sh) then
    pset(x+ix,y+iy,sget(sx+xx,sy+yy))
   end
  end
 end
end

function scroll_camera(s)

	--basic scrolling
	--cx = px - 64
	--cy = py - 64

	--[[slighty less basic 
	scrolling	
	--]]
	if s then
		cx=p.x-50+p.sw/2
		cy=p.y-50+p.sh/2
	else
		if p.x <= box.x then
			cx -= box.x - p.x
			box.x=p.x

		elseif p.x+p.sw*8 >= box.x+box.w then
			local diff = (p.x+p.sw*8) - (box.x + box.w)
			cx += diff
			box.x += diff
		end


		if p.y < box.y then
			cy -= box.y - p.y
			box.y -= box.y - p.y
		end

		if p.y+p.sh*8 > box.y + box.h then
			local diffy = (p.y+p.sh*8) - (box.y+box.h)
			cy += diffy
			box.y += diffy
		end
	end
end

function animate(p)
	if p.state != p.play then
		p.state = p.play
		p.animindex=1
		p.time=0
	elseif #p.anims[p.state] > 1 then
		p.time+=1
		if p.time > p.anims[p.state].fr then
			p.time=0
			p.animindex = (p.animindex % #p.anims[p.state]) + 1
			if p.animindex==1 and p.anims[p.state].next then
				p.play=p.anims[p.state].next
				p.state=p.play
			end
		end
	end
	p.spr = p.anims[p.state][p.animindex]
end

-->8
--update


function game_update()
	if p.space then
		update_player()
		scroll_camera()
		update_astronaut()
		--land()
	else
		update_player()
		scroll_camera(true)
	end
end
